# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps.
# Never commit real values. GitHub Pages builds need these as GitHub Actions secrets
# (same VITE_FIREBASE_* names) if you later initialize Firebase in the deployed site.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
